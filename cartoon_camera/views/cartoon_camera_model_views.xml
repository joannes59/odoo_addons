<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Modèles de caméra -->
    <record id="view_cartoon_camera_model_list" model="ir.ui.view">
        <field name="name">cartoon.camera.model.list</field>
        <field name="model">cartoon.camera.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_name"/>
                <field name="model_name"/>
                <field name="max_resolution"/>
            </list>
        </field>
    </record>

    <record id="view_cartoon_camera_model_form" model="ir.ui.view">
        <field name="name">cartoon.camera.model.form</field>
        <field name="model">cartoon.camera.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="vendor_name"/>
                            <field name="model_name"/>
                            <field name="max_resolution"/>
                        </group>
                        <group>
                            <field name="id_vendor"/>
                            <field name="id_model"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions et menus -->
    <record id="action_cartoon_camera_model" model="ir.actions.act_window">
        <field name="name">Modele</field>
        <field name="res_model">cartoon.camera.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cartoon_camera_model" name="Modele"
              parent="cartoon_camera.menu_cartoon_configuration_camera"
              action="action_cartoon_camera_model"/>

</odoo>