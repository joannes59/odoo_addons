<odoo>
    <record id="view_cartoon_image_list" model="ir.ui.view">
        <field name="name">cartoon.image.list</field>
        <field name="model">cartoon.image</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="directory"/>
                <field name="height"/>
                <field name="width"/>
                <field name="offset_x"/>
                <field name="offset_y"/>
                <field name="path_id"/>
            </list>
        </field>
    </record>

    <record id="view_cartoon_image_form" model="ir.ui.view">
        <field name="name">cartoon.image.form</field>
        <field name="model">cartoon.image</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="image" invisible="name == False">
                        <group>
                            <field name="encoded_image"
                                   widget="image"
                                   filename="path"
                                   nolabel="1"
                                   alt="Image preview"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="directory"/>
                            <field name="height"/>
                            <field name="width"/>
                            <field name="offset_x"/>
                            <field name="offset_y"/>
                            <field name="path" invisible="1"/>
                        </group>
                    </group>
                    <button name="%(action_cartoon_image_import_wizard)d"
                            type="action"
                            string="Importer une image"
                            class="btn-secondary"
                            invisible="name != False"/>
                    <notebook/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cartoon_image_kanban" model="ir.ui.view">
        <field name="name">cartoon.image.kanban</field>
        <field name="model">cartoon.image</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <templates>
                    <t t-name="kanban-box">

                        <div class="oe_kanban_global_click o_kanban_record">
                            <div>
                                <field name="name"/>
                            </div>
                            <table>
                                <tr>
                                    <td>
                                        <div>
                                            <img t-att-src="kanban_image('cartoon.image', 'encoded_image', record.id.value)"
                                                 t-att-alt="record.name.value"
                                            style="width: 196px;"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="o_kanban_details">
                                            <field name="width"/>
                                            x
                                            <field name="height"/>
                                            px
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Sous-menu pour Images -->
    <record id="action_cartoon_image" model="ir.actions.act_window">
        <field name="name">Images</field>
        <field name="res_model">cartoon.image</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p>Manage your images here.</p>
        </field>
    </record>

    <menuitem id="menu_cartoon_image"
              name="Images"
              sequence="10"
              parent="menu_cartoon_images"
              action="action_cartoon_image"
              groups="base.group_user"/>

</odoo>