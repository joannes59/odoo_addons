<odoo>
  <record id="view_cartoon_image_import_wizard" model="ir.ui.view">
    <field name="name">cartoon.image.import.wizard.form</field>
    <field name="model">cartoon.image.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Importer une image">
        <group>
          <field name="image_file" filename="filename"/>
          <field name="filename"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Importer" class="btn-primary"/>
          <button string="Annuler" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_cartoon_image_import_wizard" model="ir.actions.act_window">
    <field name="name">Importer une image</field>
    <field name="res_model">cartoon.image.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
